<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Cccc.Adapters.Outbound.Toast.Wpf</AssemblyName>
    <RootNamespace>Cccc.Adapters.Outbound.Toast.Wpf</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cccc.Domain\Cccc.Domain.csproj" />
    <ProjectReference Include="..\Cccc.Application\Cccc.Application.csproj" />
    <ProjectReference Include="..\Cccc.Platform.Windows\Cccc.Platform.Windows.csproj" />
    <ProjectReference Include="..\Cccc.MaterialShape\Cccc.MaterialShape.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Cccc.Presentation.Verification</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="$(FontDirectory)\vivoSans-Medium.ttf" Link="Fonts\vivoSans-Medium.ttf"
              Condition="Exists('$(FontDirectory)\vivoSans-Medium.ttf')" />
    <Resource Include="$(FontDirectory)\vivoSans-Bold.ttf" Link="Fonts\vivoSans-Bold.ttf"
              Condition="Exists('$(FontDirectory)\vivoSans-Bold.ttf')" />
  </ItemGroup>
</Project>
