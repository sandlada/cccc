<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cccc.Application</AssemblyName>
    <RootNamespace>Cccc.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cccc.Domain\Cccc.Domain.csproj" />
  </ItemGroup>

  <Target Name="ForbidOutwardPackages" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_Forbidden Include="@(PackageReference)" />
    </ItemGroup>
    <Error Condition="'@(_Forbidden)' != ''"
           Text="Cccc.Application must stay framework-free. Found: @(_Forbidden)." />
  </Target>
</Project>
